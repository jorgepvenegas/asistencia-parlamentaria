---
import PageLayout from '../../layouts/PageLayout.astro';
import StatCards from '../../components/StatCards';
import { ATTENDANCE_COLORS, PARTY_ABBREV, PARTY_COLORS } from '../../constants/colors';
import { toPartySlug } from '../../utils/partySlug';
import type { PoliticianAttendance, PartyAttendance } from '../../types/dashboard';
import {
  politicianResponseSchema,
  partyResponseSchema,
  attendanceYearlyResponseSchema,
  partyAttendanceYearlyResponseSchema,
  type PoliticianResponse,
  type PartyResponse,
  type AttendanceYearlyResponse,
  type PartyAttendanceYearlyResponse,
} from '@quienatiende/shared/schemas';
import { z } from 'zod';
import MembersTableV2 from '@/components/MembersTableV2';
import SectionHeader from '@/components/SectionHeader';

export function getStaticPaths() {
  const years = ['2022', '2023', '2024', '2025'];
  const partySlugs = Array.from(
    new Set(
      [...Object.keys(PARTY_ABBREV), ...Object.keys(PARTY_COLORS), 'Sin partido']
        .map((name) => toPartySlug(name))
        .filter(Boolean)
    )
  );

  return years.flatMap((year) => partySlugs.map((partySlug) => ({ params: { year, partySlug } })));
}

const yearNum = parseInt(Astro.params.year ?? '', 10);
const partySlugParam = Astro.params.partySlug ?? '';

if (!Number.isFinite(yearNum) || yearNum < 2022 || !partySlugParam) {
  return Astro.redirect('/2025');
}

const API_URL = import.meta.env.PUBLIC_BASE_URL_API || 'http://localhost:3000';
const C = ATTENDANCE_COLORS;

const politiciansArraySchema = z.array(politicianResponseSchema);
const partiesArraySchema = z.array(partyResponseSchema);
const attendanceArraySchema = z.array(attendanceYearlyResponseSchema);
const partyAttendanceArraySchema = z.array(partyAttendanceYearlyResponseSchema);

type ApiPolitician = PoliticianResponse;
type ApiParty = PartyResponse;
type ApiAttendance = AttendanceYearlyResponse;
type ApiPartyAttendance = PartyAttendanceYearlyResponse;

async function parseResponse<T>(
  res: Response,
  schema: z.ZodType<T>,
  label: string
): Promise<T | null> {
  if (!res.ok) return null;
  const { data } = await res.json();
  const result = schema.safeParse(data);
  if (result.success) return result.data;
  console.error(`${label} validation failed:`, result.error);
  return null;
}

let politicians: PoliticianAttendance[] = [];
let partyAttendance: PartyAttendance[] = [];
let error: string | null = null;

try {
  const [politiciansRes, partiesRes, attendanceRes, partyAttendanceRes] = await Promise.all([
    fetch(`${API_URL}/api/politicians`),
    fetch(`${API_URL}/api/parties`),
    fetch(`${API_URL}/api/attendance/yearly?year=${yearNum}`),
    fetch(`${API_URL}/api/attendance/parties/yearly?year=${yearNum}`),
  ]);

  const politiciansData =
    (await parseResponse<ApiPolitician[]>(politiciansRes, politiciansArraySchema, 'Politicians')) ??
    [];
  const partiesData =
    (await parseResponse<ApiParty[]>(partiesRes, partiesArraySchema, 'Parties')) ?? [];
  const attendanceData =
    (await parseResponse<ApiAttendance[]>(attendanceRes, attendanceArraySchema, 'Attendance')) ??
    [];
  const partyAttendanceData =
    (await parseResponse<ApiPartyAttendance[]>(
      partyAttendanceRes,
      partyAttendanceArraySchema,
      'Party attendance'
    )) ?? [];

  const politicianMap = new Map(politiciansData.map((p) => [p.id, p]));
  const partyMap = new Map(partiesData.map((p) => [p.id, p]));

  politicians = attendanceData
    .map((att) => {
      const politician = politicianMap.get(att.politicianId);
      if (!politician) return null;
      const party = partyMap.get(politician.partyId);

      const adjustedTotalSessions =
        att.attendanceCount +
        att.justifiedAbsentCount +
        att.unjustifiedAbsentCount +
        att.absentCount;

      const avgAttendance =
        adjustedTotalSessions > 0
          ? ((att.attendanceCount / adjustedTotalSessions) * 100).toFixed(2)
          : '0.00';
      const avgValidJust =
        adjustedTotalSessions > 0
          ? ((att.justifiedAbsentCount / adjustedTotalSessions) * 100).toFixed(2)
          : '0.00';
      const avgInvalidJust =
        adjustedTotalSessions > 0
          ? ((att.unjustifiedAbsentCount / adjustedTotalSessions) * 100).toFixed(2)
          : '0.00';
      const avgNoJust =
        adjustedTotalSessions > 0
          ? ((att.absentCount / adjustedTotalSessions) * 100).toFixed(2)
          : '0.00';

      return {
        id: att.politicianId,
        name: politician.name,
        party: party?.name || 'Sin partido',
        partyId: politician.partyId,
        attendanceCount: att.attendanceCount,
        avgAttendance: parseFloat(avgAttendance),
        justifiedAbsentCount: att.justifiedAbsentCount,
        avgValidJust: parseFloat(avgValidJust),
        unjustifiedAbsentCount: att.unjustifiedAbsentCount,
        avgInvalidJust: parseFloat(avgInvalidJust),
        absentCount: att.absentCount,
        avgNoJust: parseFloat(avgNoJust),
        pct: parseFloat(att.attendanceAverage.toFixed(2)),
      } as PoliticianAttendance;
    })
    .filter((p): p is PoliticianAttendance => p !== null);

  const memberCountByParty = new Map<number, number>();
  for (const p of politiciansData) {
    memberCountByParty.set(p.partyId, (memberCountByParty.get(p.partyId) ?? 0) + 1);
  }

  partyAttendance = partyAttendanceData.map((p) => {
    const adjustedTotalSessions =
      p.attendanceCount + p.justifiedAbsentCount + p.unjustifiedAbsentCount + p.absentCount;

    return {
      ...p,
      avgAttendance:
        adjustedTotalSessions > 0
          ? parseFloat(((p.attendanceCount / adjustedTotalSessions) * 100).toFixed(2))
          : 0,
      avgValidJust:
        adjustedTotalSessions > 0
          ? parseFloat(((p.justifiedAbsentCount / adjustedTotalSessions) * 100).toFixed(2))
          : 0,
      avgInvalidJust:
        adjustedTotalSessions > 0
          ? parseFloat(((p.unjustifiedAbsentCount / adjustedTotalSessions) * 100).toFixed(2))
          : 0,
      avgNoJust:
        adjustedTotalSessions > 0
          ? parseFloat(((p.absentCount / adjustedTotalSessions) * 100).toFixed(2))
          : 0,
      memberCount: memberCountByParty.get(p.partyId) ?? 0,
    };
  });
} catch (err) {
  error = 'Error connecting to server';
  console.error(err);
}

const selectedParty =
  partyAttendance.find((party) => toPartySlug(party.partyName) === partySlugParam) ?? null;

if (!error && !selectedParty) {
  return Astro.redirect(`/${yearNum}`);
}

const selectedPartyMembers = selectedParty
  ? politicians.filter((politician) => politician.partyId === selectedParty.partyId)
  : [];
const AVAILABLE_YEARS = [2025, 2024, 2023, 2022];
---

<PageLayout
  title={`QuienAtiende - ${selectedParty?.partyName ?? 'Detalle partido'}`}
  description="Detalle de asistencia por partido político"
  year={yearNum}
  backLink={`/${yearNum}`}
>
  <style>
    .party-header-row {
      display: flex;
      gap: 20px;
      justify-content: space-between;
      padding: 15px 0 40px;
    }
    .party-header-left {
      flex: 1;
      min-width: 0;
    }
    .year-selector {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: #5e5e5e;
      white-space: nowrap;
    }
    @media (max-width: 767px) {
      .party-header-row {
        flex-direction: column;
        gap: 16px;
        align-items: flex-end;
      }
      .year-selector {
        width: auto;
      }
    }
  </style>

  {
    error ? (
      <div
        style={{
          minHeight: '60vh',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
        }}
      >
        <div
          style={{
            background: '#16162a',
            borderRadius: 16,
            padding: 32,
            border: '1px solid rgba(255,255,255,0.06)',
            textAlign: 'center',
          }}
        >
          <p style={{ color: '#E63946', fontWeight: 600, marginBottom: 8 }}>
            Error al cargar datos
          </p>
          <p style={{ color: '#777' }}>{error}</p>
        </div>
      </div>
    ) : (
      selectedParty && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
          <div class="party-header-row">
            <div class="party-header-left">
              <SectionHeader
                title={selectedParty.partyName}
                description={`Totales de asistencia anual por miembro de partido`}
              />
            </div>
            <div class="year-selector">
              <span>Año</span>
              <select
                aria-label="Seleccionar año"
                onchange={`const qs = window.location.search; window.location.href='/' + this.value + '/${partySlugParam}' + qs`}
                style={{
                  padding: '10px 16px',
                  border: '1px solid #E5E5E5',
                  background: 'transparent',
                  fontSize: 12,
                  fontWeight: 500,
                  cursor: 'pointer',
                  appearance: 'auto',
                }}
              >
                {AVAILABLE_YEARS.map((y) => (
                  <option key={y} value={y} selected={y === yearNum}>
                    {y}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <StatCards
            cards={[
              {
                label: 'ASISTENCIA PROMEDIO',
                pct: selectedParty.avgAttendance.toFixed(1),
                frac: selectedParty.avgAttendance / 100,
                color: C.attendance,
              },
              {
                label: 'FALTAS JUSTIFICADAS',
                pct: selectedParty.avgValidJust.toFixed(1),
                frac: selectedParty.avgValidJust / 100,
                color: C.justified,
              },
              {
                label: 'FALTAS SIN JUSTIFICACIÓN VÁLIDA',
                pct: selectedParty.avgInvalidJust.toFixed(1),
                frac: selectedParty.avgInvalidJust / 100,
                color: C.unjustified,
              },
              {
                label: 'FALTAS SIN JUSTIFICACIÓN',
                pct: selectedParty.avgNoJust.toFixed(1),
                frac: selectedParty.avgNoJust / 100,
                color: C.noJust,
              },
            ]}
          />

          <div style={{ marginTop: 16 }}>
            <SectionHeader
              title="Asistencia por diputado/a"
              description="Totales de asistencia, ausencias justificadas e injustificadas por miembro del partido"
            />
          </div>
          <MembersTableV2
            client:load
            members={selectedPartyMembers}
            party={selectedParty.partyName}
            showPct={false}
          />
        </div>
      )
    )
  }
</PageLayout>
