---
import PageLayout from '../../../layouts/PageLayout.astro';
import ErrorState from '../../../components/ErrorState.astro';
import StatCards from '../../../components/StatCards';
import { ATTENDANCE_COLORS, PARTY_ABBREV, PARTY_COLORS } from '../../../constants/colors';
import { toPartySlug } from '../../../utils/partySlug';
import type { PoliticianAttendance, PartyAttendance } from '../../../types/dashboard';
import {
  API_URL,
  parseResponse,
  politiciansArraySchema,
  partiesArraySchema,
  attendanceArraySchema,
  partyAttendanceArraySchema,
} from '../../../utils/api';
import {
  transformPolitician,
  transformPartyAttendance,
  buildMemberCountByParty,
} from '../../../utils/transform';
import MembersTableV2 from '@/components/MembersTableV2';
import PageHeaderRow from '@/components/PageHeaderRow.astro';
import SectionHeader from '@/components/SectionHeader';

export function getStaticPaths() {
  const years = ['2022', '2023', '2024', '2025'];
  const partySlugs = Array.from(
    new Set(
      [...Object.keys(PARTY_ABBREV), ...Object.keys(PARTY_COLORS), 'Sin partido']
        .map((name) => toPartySlug(name))
        .filter(Boolean)
    )
  );

  return years.flatMap((year) => partySlugs.map((partySlug) => ({ params: { year, partySlug } })));
}

const yearNum = parseInt(Astro.params.year ?? '', 10);
const partySlugParam = Astro.params.partySlug ?? '';

if (!Number.isFinite(yearNum) || yearNum < 2022 || !partySlugParam) {
  return Astro.redirect('/partidos/2025');
}

const C = ATTENDANCE_COLORS;

let politicians: PoliticianAttendance[] = [];
let partyAttendance: PartyAttendance[] = [];
let error: string | null = null;

try {
  const [politiciansRes, partiesRes, attendanceRes, partyAttendanceRes] = await Promise.all([
    fetch(`${API_URL}/api/politicians`),
    fetch(`${API_URL}/api/parties`),
    fetch(`${API_URL}/api/attendance/yearly?year=${yearNum}`),
    fetch(`${API_URL}/api/attendance/parties/yearly?year=${yearNum}`),
  ]);

  const politiciansData =
    (await parseResponse(politiciansRes, politiciansArraySchema, 'Politicians')) ?? [];
  const partiesData = (await parseResponse(partiesRes, partiesArraySchema, 'Parties')) ?? [];
  const attendanceData =
    (await parseResponse(attendanceRes, attendanceArraySchema, 'Attendance')) ?? [];
  const partyAttendanceData =
    (await parseResponse(partyAttendanceRes, partyAttendanceArraySchema, 'Party attendance')) ?? [];

  const politicianMap = new Map(politiciansData.map((p) => [p.id, p]));
  const partyMap = new Map(partiesData.map((p) => [p.id, p]));
  const memberCountByParty = buildMemberCountByParty(politiciansData);

  politicians = attendanceData
    .map((att) => transformPolitician(att, politicianMap, partyMap))
    .filter((p): p is PoliticianAttendance => p !== null);

  partyAttendance = partyAttendanceData.map((p) => transformPartyAttendance(p, memberCountByParty));
} catch (err) {
  error = 'Error connecting to server';
  console.error(err);
}

const selectedParty =
  partyAttendance.find((party) => toPartySlug(party.partyName) === partySlugParam) ?? null;

if (!error && !selectedParty) {
  return Astro.redirect(`/partidos/${yearNum}`);
}

const selectedPartyMembers = selectedParty
  ? politicians.filter((politician) => politician.partyId === selectedParty.partyId)
  : [];
const AVAILABLE_YEARS = [2025, 2024, 2023, 2022];
---

<PageLayout
  title={`QuienAtiende - ${selectedParty?.partyName ?? 'Detalle partido'}`}
  description="Detalle de asistencia por partido político"
  year={yearNum}
  backLink="/"
>
  {
    error ? (
      <ErrorState message={error} />
    ) : (
      selectedParty && (
        <div class="flex flex-col gap-4 w-full">
          <PageHeaderRow
            title={selectedParty.partyName}
            description={`Resumen de asistencia del partido en el periodo ${yearNum}`}
            year={yearNum}
            availableYears={AVAILABLE_YEARS}
            basePath={`/partidos/${partySlugParam}/`}
          />

          <StatCards
            cards={[
              {
                label: 'ASISTENCIA PROMEDIO',
                pct: selectedParty.avgAttendance.toFixed(1),
                frac: selectedParty.avgAttendance / 100,
                color: C.attendance,
              },
              {
                label: 'FALTAS JUSTIFICADAS',
                pct: selectedParty.avgValidJust.toFixed(1),
                frac: selectedParty.avgValidJust / 100,
                color: C.justified,
              },
              {
                label: 'FALTAS SIN JUSTIFICACIÓN VÁLIDA',
                pct: selectedParty.avgInvalidJust.toFixed(1),
                frac: selectedParty.avgInvalidJust / 100,
                color: C.unjustified,
              },
              {
                label: 'FALTAS SIN JUSTIFICACIÓN',
                pct: selectedParty.avgNoJust.toFixed(1),
                frac: selectedParty.avgNoJust / 100,
                color: C.noJust,
              },
            ]}
          />

          <div class="mt-4">
            <SectionHeader
              title="Asistencia por diputado/a"
              description="Totales de asistencia, ausencias justificadas e injustificadas por miembro del partido"
            />
          </div>
          <MembersTableV2
            client:load
            members={selectedPartyMembers}
            party={selectedParty.partyName}
            showPct={false}
          />
        </div>
      )
    )
  }
</PageLayout>
