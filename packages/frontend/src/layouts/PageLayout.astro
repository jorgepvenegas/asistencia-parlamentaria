---
import '../styles/shared.css';
import SiteHeader from '../components/SiteHeader';
import SiteFooter from '../components/SiteFooter';

interface Props {
  title: string;
  description?: string;
  year?: number;
  backLink?: string;
  backLabel?: string;
}

const {
  title,
  description = 'Transparencia sobre la asistencia de diputados a sesiones parlamentarias',
  year = 2025,
  backLink,
  backLabel = '← Home',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      .page-container {
        width: 100%;
        max-width: 1536px;
        margin: 0 auto;
        padding: 48px 64px;
        box-sizing: border-box;
      }
      .page-header-row {
        display: flex;
        gap: 20px;
        justify-content: space-between;
        padding: 15px 0 40px;
      }
      .page-header-left {
        flex: 1;
        min-width: 0;
      }
      .year-selector {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #5e5e5e;
        white-space: nowrap;
      }
      .back-link {
        display: inline-flex;
        padding: 8px 12px;
        font-size: 12px;
        color: #2563eb;
        text-decoration: none;
      }
      .back-link:hover {
        text-decoration: underline;
      }
      @media (max-width: 767px) {
        .page-container {
          padding: 32px 20px;
        }
        .page-header-row {
          flex-direction: column;
          gap: 16px;
          align-items: flex-end;
        }
        .year-selector {
          width: auto;
        }
      }
    </style>
  </head>
  <body style="margin:0; padding:0; background:#FAFAFA;">
    <div
      style={{
        fontFamily: "'Sora', sans-serif",
        background: '#FAFAFA',
        color: '#000',
        minHeight: '100vh',
        display: 'flex',
        flexDirection: 'column',
      }}
    >
      <SiteHeader client:load />

      <main class="page-container" style="flex: 1;">
        {
          backLink && (
            <a href={backLink} class="back-link">
              {backLabel}
            </a>
          )
        }

        <slot />
      </main>

      <SiteFooter year={year} />
    </div>
  </body>
</html>
