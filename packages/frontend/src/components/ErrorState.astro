---
interface Props {
  message: string;
}
const { message } = Astro.props;
---

<div class="min-h-screen flex items-center justify-center">
  <div class="bg-surface-dark rounded-2xl p-8 border border-white/[0.06] text-center">
    <p class="text-error font-semibold mb-2">Error al cargar datos</p>
    <p class="text-[#777]">{message}</p>
  </div>
</div>
