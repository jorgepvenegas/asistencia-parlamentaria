{
  "permissions": {
    "allow": [
      "Bash(.specify/scripts/bash/setup-plan.sh:*)",
      "Bash(.specify/scripts/bash/check-prerequisites.sh:*)",
      "Bash(tree:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm --filter @quienatiende/automation exec tsc:*)",
      "Bash(pnpm --filter @quienatiende/automation lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(uvx:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(pnpm -F @quienatiende/frontend lint:*)",
      "Bash(pnpm -F @quienatiende/frontend build:*)",
      "Bash(pnpm -F @quienatiende/frontend exec eslint:*)"
    ]
  },
  "enabledPlugins": {
    "arscontexta@agenticnotetaking": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-orient.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-note.sh \"$TOOL_INPUT_FILE_PATH\""
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-commit.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-capture.sh"
          }
        ]
      }
    ]
  }
}
